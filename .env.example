# Earth Sentinel — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.

# ── Go Backend ──────────────────────────────────────────────────────────────
DATABASE_URL=postgres://earthsentinel:earthsentinel@localhost:5432/earthsentinel
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio-access-key
MINIO_SECRET_KEY=minio-secret-key
MINIO_BUCKET=earth-sentinel
PORT=8080

# ── Node.js Frontend Server ──────────────────────────────────────────────────
# PORT=3000  (default, override if needed)
GO_BACKEND_URL=http://localhost:8080

# ── External APIs (paid/auth-required) ──────────────────────────────────────
# Alpha Vantage — 5 req/min on free plan
ALPHA_VANTAGE_KEY=your-key-here

# MediaCloud — 4000 req/week on free plan
MEDIACLOUD_API_KEY=your-key-here

# ── Free APIs (no key needed) ────────────────────────────────────────────────
# USGS, NOAA SWPC, NASA EONET, GDACS, Open-Meteo, Stooq, GDELT
# No configuration needed.
